# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=default

# CloudFormation stack name
CF_STACK_NAME=r18-anime-stack

# S3 bucket for models, outputs, logs
S3_BUCKET=r18-anime-assets

# EC2 settings
MY_IP=YOUR_IP_HERE/32

# Preferred Availability Zone (us-east-1c or us-east-1d)
PREFERRED_AZ=us-east-1c

# Instance types
DEFAULT_INSTANCE_TYPE=g6e.xlarge
FALLBACK_INSTANCE_TYPE=g5.xlarge

# EBS Volume ID (set after CloudFormation deploy)
EBS_VOLUME_ID=

# Launch Template ID (set after CloudFormation deploy)
LAUNCH_TEMPLATE_ID=

# Public Subnet ID (set after CloudFormation deploy)
SUBNET_ID=

# Security Group ID (set after CloudFormation deploy)
SG_ID=

# CloudFront + ALB (set after CloudFormation deploy)
CLOUDFRONT_URL=
TARGET_GROUP_ARN=
PRIVATE_SUBNET_ID=

# Data paths on EC2
DATA_DIR=/data
COMFYUI_DIR=/data/ComfyUI
MODELS_DIR=/data/ComfyUI/models
OUTPUT_DIR=/data/ComfyUI/output
